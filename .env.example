# Copy this file to .env.local for local development.
# .env.local is gitignored; never commit real keys.
#
# ── Gemini API Key ──────────────────────────────────────────────────────────
# Used ONLY by the Vercel serverless function at api/study-plan.ts.
# Obtain your key at: https://aistudio.google.com/app/apikey
#
# In Vercel production: set this in the Vercel dashboard under
# Project → Settings → Environment Variables.
#
# IMPORTANT: This variable must NOT be prefixed with VITE_
# It is intentionally kept server-side only.
GEMINI_API_KEY=your_gemini_api_key_here
